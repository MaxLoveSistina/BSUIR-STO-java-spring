# Скопируйте в .env:  cp .env.example .env

# --- PostgreSQL ---
DB_NAME=autoservice
DB_USER=postgres
DB_PASS=change_me_please
DB_PORT=5432

# --- Backend ---
SERVER_PORT=8080
SPRING_DDL_AUTO=update

# Секрет JWT: минимум 32 символа (256 бит). Сгенерировать: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret_at_least_32_chars_long
JWT_EXPIRATION=86400000

# Демо-данные (2 мастера, 2 клиента, услуги) в пустой БД. Пароль у всех: password123
DEMO_DATA=true

# --- Frontend ---
FRONTEND_PORT=3000
# Адреса, с которых разрешены запросы к API (через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
